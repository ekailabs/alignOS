#!/usr/bin/env node
'use strict';
// alignOS Assist CLI — the headless surface over the same logic the Electron app uses.
//   alignos setup --url <gateway>      connect to your private space
//   alignos status                     connection health
//   alignos inbox                      requests that need you
//   alignos show <id>                  one request + the drafted reply
//   alignos draft <id>                 draft a reply locally with claude/codex and print it
//   alignos watch                      run the drafting loop headless for all incoming requests
//   alignos approve <id>               send the reply
//   alignos followup <id> --msg <t>    ask the assistant to revise (--msg - reads stdin)
//   alignos decline <id> [--note <t>]  refuse
//   alignos ask --owner <handle> [--mode quick|deep] <question>
//   alignos mcp                         stdio MCP bridge for local tools
const mc = require('../src/mesh-client');
const cfg = require('../src/config');
const store = require('../src/inbox-store');

const argv = process.argv.slice(2);
const flag = (name) => { const i = argv.indexOf(name); return i >= 0 ? argv[i + 1] : undefined; };
const hasFlag = (name) => argv.includes(name);
const text = (parts = []) => parts.filter((p) => p.kind === 'text').map((p) => p.text).join('\n');
function askQuestion() {
  const qFlag = flag('--question') || flag('--msg');
  if (qFlag === '-') return require('fs').readFileSync(0, 'utf8').trim();
  if (qFlag) return qFlag;
  const skipValueFor = new Set(['--mode', '--owner', '--provider', '--url', '--question', '--msg']);
  const parts = [];
  for (let i = 1; i < argv.length; i++) {
    const a = argv[i];
    if (skipValueFor.has(a)) { i++; continue; }
    if (a.startsWith('--')) continue;
    parts.push(a);
  }
  const q = parts.join(' ').trim();
  return q === '-' ? require('fs').readFileSync(0, 'utf8').trim() : q;
}
function seedOpts() {
  if (hasFlag('--all')) return { days: null, maxPairs: 1500 };
  const days = Number(flag('--days') || 7);
  if (!Number.isFinite(days) || days <= 0) throw new Error('--days must be a positive number');
  return { days, maxPairs: 1500 };
}

// Accept a short id prefix (as shown by `inbox`) and resolve it to the full task id.
async function resolveId(s) {
  if (!s) throw new Error('a task id is required');
  if (s.length >= 36) return s;
  const all = await mc.rpc('tasks/list', {}, { owner: true });
  const hits = all.filter((t) => t.id.startsWith(s));
  if (hits.length === 1) return hits[0].id;
  throw new Error(hits.length ? `ambiguous id "${s}"` : `no task matches "${s}"`);
}

async function main() {
  const cmd = argv[0];
  let id = argv[1] && !argv[1].startsWith('--') ? argv[1] : undefined;
  if (['show', 'approve', 'followup', 'decline', 'draft'].includes(cmd)) id = await resolveId(id);
  switch (cmd) {
    case 'setup': {
      const url = (flag('--url') || (argv[1] && !argv[1].startsWith('--') ? argv[1] : '')).replace(/\/$/, '');
      if (!url) throw new Error('usage: alignos setup --url <gateway>');
      cfg.save({ url });
      await require('../src/identity').claim(url, '');
      console.log('claimed ownership of', url);
      process.stderr.write(`seeding your assistant from your agent logs (${hasFlag('--all') ? 'all history' : `${seedOpts().days} days`})…\n`);
      try {
        const { pairs, stats } = require('../src/agent-logs').ingestCorpus(seedOpts());
        const { chains } = require('../src/agent-logs').ingestStyle(seedOpts());
        const r = await mc.uploadKnowledge(pairs, chains);
        console.log(`seeded ${r.count} prompt/output pairs from ${stats.sessions} sessions`);
      } catch (e) { console.error('seed skipped:', e.message); }
      break;
    }
    case 'seed': {
      const { pairs, stats } = require('../src/agent-logs').ingestCorpus(seedOpts());
      const { chains } = require('../src/agent-logs').ingestStyle(seedOpts());
      const r = await mc.uploadKnowledge(pairs, chains);
      console.log(`seeded ${r.count} prompt/output pairs from ${stats.sessions} sessions`);
      break;
    }
    case 'status':
      console.log('private space:', cfg.load().url || '(not set — run: alignos setup --url <gateway>)');
      break;
    case 'ask': {
      const question = askQuestion();
      const mode = flag('--mode') || 'quick';
      const owner = flag('--owner') || flag('--provider');
      const url = flag('--url');
      if (!question) throw new Error('usage: alignos ask --owner <handle> [--mode quick|deep] <question>');
      if (!owner && !url) throw new Error('ask requires --owner <handle> or --url <ask-endpoint>');
      const t = await mc.requestProvider({ question, mode, owner, url });
      console.log(`${t.id.slice(0, 8)}  ${t.status.state}`);
      const answer = text(t.artifacts && t.artifacts[0] && t.artifacts[0].parts);
      if (answer) console.log(answer);
      break;
    }
    case 'mcp':
      require('../src/mcp-server').serve();
      break;
    case 'inbox': {
      const tasks = await mc.inbox();
      if (!tasks.length) { console.log("You're all caught up — nothing needs you."); break; }
      console.log(`${tasks.length} request(s) need you:\n`);
      for (const t of tasks) {
        const ask = text(t.history && t.history[0] && t.history[0].parts).replace(/\s+/g, ' ').slice(0, 64);
        console.log(`  ${t.id.slice(0, 8)}  ${(t.from && t.from.display) || 'someone'} — "${ask}"  [${t.status.state}]`);
      }
      break;
    }
    case 'show': {
      if (!id) throw new Error('usage: alignos show <id>');
      const t = await mc.getTask(id);
      console.log('from:   ', (t.from && t.from.display) || '?');
      console.log('asked:  ', text(t.history && t.history[0] && t.history[0].parts));
      console.log('draft:  ', text(t.artifacts && t.artifacts[0] && t.artifacts[0].parts));
      console.log('state:  ', t.status.state);
      break;
    }
    case 'approve': {
      if (!id) throw new Error('usage: alignos approve <id>');
      const t = await mc.approve(id);
      store.record({ taskId: id, verdict: 'approve' });
      console.log('approved → sent.  task is now', t.status.state);
      break;
    }
    case 'followup': {
      if (!id) throw new Error('usage: alignos followup <id> --msg <text>');
      let msg = flag('--msg');
      if (msg === '-') msg = require('fs').readFileSync(0, 'utf8').trim();
      const t = await mc.followup(id, msg || '');
      store.record({ taskId: id, verdict: 'followup', instruction: msg });
      console.log('follow-up sent; assistant re-drafted.  task is now', t.status.state);
      break;
    }
    case 'decline': {
      if (!id) throw new Error('usage: alignos decline <id> [--note <text>]');
      const note = flag('--note');
      const t = await mc.decline(id, note);
      store.record({ taskId: id, verdict: 'decline', note });
      console.log('declined.  task is now', t.status.state);
      break;
    }
    case 'draft': {
      if (!id) throw new Error('usage: alignos draft <id>');
      const loop = require('../src/draft-loop');
      const t = await mc.getTask(id);
      process.stderr.write('drafting locally…\n');
      const d = await loop.draftTask(t);
      if (d.status !== 'ready') throw new Error(d.error || 'draft failed');
      console.log(d.text);
      break;
    }
    case 'watch': {
      const loop = require('../src/draft-loop');
      console.error('watching inbox — drafting incoming requests (Ctrl-C to stop)…');
      loop.start({ listInbox: () => mc.inbox(), onUpdate: (tid) => console.error('  drafted', tid.slice(0, 8)) });
      await new Promise(() => {}); // run until interrupted
      break;
    }
    default:
      console.log('alignos: setup | status | ask --owner <handle> <question> | mcp | inbox | show <id> | draft <id> | watch | approve <id> | followup <id> --msg <t> | decline <id> [--note <t>]');
  }
}

main().catch((e) => { console.error('error:', e.message); process.exit(1); });
